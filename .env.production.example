# ReportPortal — Production environment template
#
# Copy this file to `.env` (which is git-ignored) and fill in real values:
#   cp .env.production.example .env
#
# This is an alternative to `make env` (which copies .template.env). Use
# whichever you prefer — both produce a `.env` consumed by docker-compose.yml
# and docker-compose.prod.yml. Do NOT commit the resulting `.env`.

## ---------------------------------------------------------------------------
## Core credentials — CHANGE ALL OF THESE before first deployment.
## Generate strong values, e.g.: openssl rand -base64 24
## ---------------------------------------------------------------------------
POSTGRES_USER=rpuser
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_RANDOM_PASSWORD__
POSTGRES_DB=reportportal

RABBITMQ_DEFAULT_USER=rabbitmq
RABBITMQ_DEFAULT_PASS=__CHANGE_ME_STRONG_RANDOM_PASSWORD__

# Initial password for the built-in `superadmin` account. Change it again via
# the UI immediately after first login, then rotate this value too.
RP_INITIAL_ADMIN_PASSWORD=__CHANGE_ME_STRONG_RANDOM_PASSWORD__

## ---------------------------------------------------------------------------
## Service image pins
## Pin to a tested release line (matches the docker-compose.yml defaults at
## the time this file was written). Bump deliberately, not via `:latest`.
## ---------------------------------------------------------------------------
MIGRATIONS_IMAGE=reportportal/migrations:5.15.2
INDEX_IMAGE=reportportal/service-index:5.15.0
UI_IMAGE=reportportal/service-ui:5.15.3
API_IMAGE=reportportal/service-api:5.15.2
UAT_IMAGE=reportportal/service-authorization:5.15.0
JOBS_IMAGE=reportportal/service-jobs:5.15.1
ANALYZER_IMAGE=reportportal/service-auto-analyzer:5.15.2

## ---------------------------------------------------------------------------
## TLS / domain (used by docker-compose.prod.yml)
## ---------------------------------------------------------------------------
# Public DNS name pointing at this host. Used in the dashboard-kit docs and
# CI examples for RP_ENDPOINT/RP_API_URL.
RP_DOMAIN=reportportal.example.com

# Email registered with Let's Encrypt for certificate expiry notices.
ACME_EMAIL=ops@example.com

## ---------------------------------------------------------------------------
## Dashboard-kit provisioning (see dashboard-kit/README.md)
## ---------------------------------------------------------------------------
# Base API URL. Locally/behind the gateway this is https://<RP_DOMAIN>/api
RP_API_URL=https://reportportal.example.com/api

# Personal/service-account API token, generated from the RP UI after first
# login: User Profile -> "API Keys" -> Generate. Treat as a secret.
RP_API_TOKEN=__GENERATE_AFTER_FIRST_LOGIN__

# Optional: default project key used by provision_dashboards.py when no
# --project / teams.yml entry is given.
RP_DEFAULT_PROJECT=
